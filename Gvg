class Map2{

  color[][] map = new color[20][20];

  final int SQUARE_SIZE = 40;

  final color SKY = color(20,20,80);
  final color GRASS = color(0,180,120);
  final color DIRT = color(120,70,40);
  final color STONE = color(90);
  final color WATER = color(0,120,255);
  final color SAND = color(220,200,120);
  final color OAK = color(120,60,20);
  final color LEAVES = color(0,140,70);

  color STAR;

  public void drawMap(){

    // SKY
    fill(SKY);
    noStroke();

    for(int r = 0; r < 18; r++){
      for(int c = 0; c < map[r].length; c++){
        rect(c * SQUARE_SIZE, r * SQUARE_SIZE,
             SQUARE_SIZE, SQUARE_SIZE);
      }
    }

    // STARS
    for(int r = 0; r < 8; r++){
      for(int c = 0; c < map[r].length; c++){

        if((int)(Math.random() * 12) == 1){

          STAR = color(random(255),
                       random(255),
                       random(255));

          fill(STAR);

          rect(c * SQUARE_SIZE,
               r * SQUARE_SIZE,
               SQUARE_SIZE,
               SQUARE_SIZE);
        }
      }
    }

    // GRASS
    fill(GRASS);

    for(int r = 18; r < 19; r++){
      for(int c = 0; c < map[r].length; c++){

        rect(c * SQUARE_SIZE,
             r * SQUARE_SIZE,
             SQUARE_SIZE,
             SQUARE_SIZE);
      }
    }

    // DIRT
    fill(DIRT);

    for(int r = 19; r < 20; r++){
      for(int c = 0; c < map[r].length; c++){

        rect(c * SQUARE_SIZE,
             r * SQUARE_SIZE,
             SQUARE_SIZE,
             SQUARE_SIZE);
      }
    }

    // LEFT MOUNTAIN
    fill(STONE);

    for(int r = 13; r < 18; r++){
      for(int c = 0; c < 2; c++){

        rect(c * SQUARE_SIZE,
             r * SQUARE_SIZE,
             SQUARE_SIZE,
             SQUARE_SIZE);
      }
    }

    fill(STONE);

    for(int r = 11; r < 13; r++){
      for(int c = 0; c < 3; c++){

        rect(c * SQUARE_SIZE,
             r * SQUARE_SIZE,
             SQUARE_SIZE,
             SQUARE_SIZE);
      }
    }

    fill(STONE);

    for(int r = 9; r < 11; r++){
      for(int c = 0; c < 4; c++){

        rect(c * SQUARE_SIZE,
             r * SQUARE_SIZE,
             SQUARE_SIZE,
             SQUARE_SIZE);
      }
    }

    // TREE TRUNK
    fill(OAK);

    for(int r = 14; r < 18; r++){
      for(int c = 8; c < 9; c++){

        rect(c * SQUARE_SIZE,
             r * SQUARE_SIZE,
             SQUARE_SIZE,
             SQUARE_SIZE);
      }
    }

    // LEAVES
    fill(LEAVES);

    for(int r = 12; r < 14; r++){
      for(int c = 6; c < 11; c++){

        rect(c * SQUARE_SIZE,
             r * SQUARE_SIZE,
             SQUARE_SIZE,
             SQUARE_SIZE);
      }
    }

    fill(LEAVES);

    for(int r = 11; r < 12; r++){
      for(int c = 7; c < 10; c++){

        rect(c * SQUARE_SIZE,
             r * SQUARE_SIZE,
             SQUARE_SIZE,
             SQUARE_SIZE);
      }
    }

    // WATER POND
    fill(WATER);

    for(int r = 16; r < 18; r++){
      for(int c = 13; c < 17; c++){

        rect(c * SQUARE_SIZE,
             r * SQUARE_SIZE,
             SQUARE_SIZE,
             SQUARE_SIZE);
      }
    }

    // SAND AROUND WATER
    fill(SAND);

    for(int r = 15; r < 16; r++){
      for(int c = 12; c < 18; c++){

        rect(c * SQUARE_SIZE,
             r * SQUARE_SIZE,
             SQUARE_SIZE,
             SQUARE_SIZE);
      }
    }

    fill(SAND);

    for(int r = 16; r < 18; r++){
      for(int c = 12; c < 13; c++){

        rect(c * SQUARE_SIZE,
             r * SQUARE_SIZE,
             SQUARE_SIZE,
             SQUARE_SIZE);
      }
    }

    fill(SAND);

    for(int r = 16; r < 18; r++){
      for(int c = 17; c < 18; c++){

        rect(c * SQUARE_SIZE,
             r * SQUARE_SIZE,
             SQUARE_SIZE,
             SQUARE_SIZE);
      }
    }
  }
}
