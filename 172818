class Map2{

  color[][] map = new color[20][20];

  final int SQUARE_SIZE = 40;

  final color SKY = color(40,40,90);
  final color GRASS = color(0,180,100);
  final color DIRT = color(130,80,50);
  final color STONE = color(100);
  final color WATER = color(0,120,255);
  final color WOOD = color(120,70,30);
  final color LEAF = color(0,140,60);
  final color LAVA = color(255,80,0);

  public void drawMap(){

    noStroke();

    // SKY
    fill(SKY);

    for(int r = 0; r < 18; r++){
      for(int c = 0; c < 20; c++){

        rect(c * SQUARE_SIZE,
             r * SQUARE_SIZE,
             SQUARE_SIZE,
             SQUARE_SIZE);
      }
    }

    // GROUND
    fill(GRASS);

    for(int r = 18; r < 19; r++){
      for(int c = 0; c < 20; c++){

        rect(c * SQUARE_SIZE,
             r * SQUARE_SIZE,
             SQUARE_SIZE,
             SQUARE_SIZE);
      }
    }

    // DIRT
    fill(DIRT);

    for(int r = 19; r < 20; r++){
      for(int c = 0; c < 20; c++){

        rect(c * SQUARE_SIZE,
             r * SQUARE_SIZE,
             SQUARE_SIZE,
             SQUARE_SIZE);
      }
    }

    // FLOATING ISLAND
    fill(STONE);

    for(int r = 5; r < 7; r++){
      for(int c = 5; c < 10; c++){

        rect(c * SQUARE_SIZE,
             r * SQUARE_SIZE,
             SQUARE_SIZE,
             SQUARE_SIZE);
      }
    }

    // TREE
    fill(WOOD);

    for(int r = 13; r < 18; r++){
      for(int c = 3; c < 4; c++){

        rect(c * SQUARE_SIZE,
             r * SQUARE_SIZE,
             SQUARE_SIZE,
             SQUARE_SIZE);
      }
    }

    fill(LEAF);

    for(int r = 11; r < 13; r++){
      for(int c = 1; c < 6; c++){

        rect(c * SQUARE_SIZE,
             r * SQUARE_SIZE,
             SQUARE_SIZE,
             SQUARE_SIZE);
      }
    }

    // WATER LAKE
    fill(WATER);

    for(int r = 16; r < 18; r++){
      for(int c = 11; c < 15; c++){

        rect(c * SQUARE_SIZE,
             r * SQUARE_SIZE,
             SQUARE_SIZE,
             SQUARE_SIZE);
      }
    }

    // LAVA PIT
    fill(LAVA);

    for(int r = 17; r < 18; r++){
      for(int c = 17; c < 19; c++){

        rect(c * SQUARE_SIZE,
             r * SQUARE_SIZE,
             SQUARE_SIZE,
             SQUARE_SIZE);
      }
    }

    // STONE PLATFORM
    fill(STONE);

    for(int r = 10; r < 11; r++){
      for(int c = 14; c < 18; c++){

        rect(c * SQUARE_SIZE,
             r * SQUARE_SIZE,
             SQUARE_SIZE,
             SQUARE_SIZE);
      }
    }
  }
}
